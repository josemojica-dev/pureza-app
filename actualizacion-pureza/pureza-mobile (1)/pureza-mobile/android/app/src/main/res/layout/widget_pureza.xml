<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤍 PUREZA"
            android:textColor="#8b8ba7"
            android:textSize="10sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/w_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#a5a5ff"
            android:textSize="46sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/w_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DÍAS LIMPIO"
            android:textColor="#8b8ba7"
            android:textSize="9sp"
            android:letterSpacing="0.15" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/w_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="👟 0"
            android:textColor="#8b8ba7"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/w_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="🆘 Tengo ganas"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_btn_bg" />

        <TextView
            android:id="@+id/w_btn2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="✓ Día limpio"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_btn_ok" />
    </LinearLayout>
</LinearLayout>
